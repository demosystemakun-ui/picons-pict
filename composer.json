{
    "name": "company/consumable-management",
    "type": "project",
    "description": "Sistem Informasi Consumable Management (ERP-style) - Laravel 13",
    "keywords": ["laravel", "erp", "consumable", "inventory"],
    "license": "MIT",
   "require": {
        "php": "^8.4",
        "barryvdh/laravel-dompdf": "^3.1.2",
        "guzzlehttp/guzzle": "^8.2.0",
        "laravel/framework": "^13.35.0",
        "maatwebsite/excel": "^4.0.3",
        "nesbot/carbon": "^3.14.2",
        "spatie/laravel-permission": "^8.3"
    },
    "require-dev": {
        "nunomaduro/collision": "^8.9.5",
        "fakerphp/faker": "^1.23",
        "laravel/pint": "^1.13",
        "laravel/sail": "^1.26",
        "mockery/mockery": "^1.6",
        "nunomaduro/collision": "^8.0",
        "phpunit/phpunit": "^11.0"
    },
    "autoload": {
        "psr-4": {
            "App\\": "app/",
            "Database\\Factories\\": "database/factories/",
            "Database\\Seeders\\": "database/seeders/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Tests\\": "tests/"
        }
    },
    "scripts": {
        "post-autoload-dump": [
            "Illuminate\\Foundation\\ComposerScripts::postAutoloadDump",
            "@php artisan package:discover --ansi"
        ],
        "post-update-cmd": [
            "@php artisan vendor:publish --tag=laravel-assets --ansi --force"
        ],
        "post-root-package-install": [
            "@php -r \"file_exists('.env') || copy('.env.example', '.env');\""
        ],
        "post-create-project-cmd": [
            "@php artisan key:generate --ansi"
        ]
    },
    "extra": {
        "laravel": {
            "dont-discover": []
        }
    },
    "config": {
        "optimize-autoloader": true,
        "preferred-install": "dist",
        "sort-packages": true,
        "allow-plugins": {
            "pestphp/pest-plugin": true,
            "php-http/discovery": true
        }
    },
    "minimum-stability": "stable",
    "prefer-stable": true
}
